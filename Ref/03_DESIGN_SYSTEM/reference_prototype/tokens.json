    "floating": "0 4px 12px rgba(14, 20, 30, 0.08), 0 1px 3px rgba(14, 20, 30, 0.06)",
    "overlay": "0 16px 48px rgba(14, 20, 30, 0.12), 0 4px 12px rgba(14, 20, 30, 0.08)",
    "spotlight": "0 0 0 1px rgba(88, 108, 255, 0.15), 0 16px 48px rgba(88, 108, 255, 0.08)"
