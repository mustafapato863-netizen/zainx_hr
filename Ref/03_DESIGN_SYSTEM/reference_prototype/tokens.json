    "standard": "220ms",
    "context": "320ms",
    "expressive": "640ms",
    "brand": "900ms"
  },
  "easing": {
    "productive": "cubic-bezier(0.2, 0, 0, 1)",
    "enter": "cubic-bezier(0.16, 1, 0.3, 1)",
    "exit": "cubic-bezier(0.4, 0, 1, 1)",
    "expressive": "cubic-bezier(0.2, 0.8, 0.2, 1)"
  },
