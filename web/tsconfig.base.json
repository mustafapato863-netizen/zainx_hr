{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@zainx/platform": ["./packages/platform/src/index.ts"],
      "@zainx/platform/*": ["./packages/platform/src/*"],
      "@zainx/design-system": ["./packages/design-system/src/index.ts"],
      "@zainx/design-system/*": ["./packages/design-system/src/*"],
      "@zainx/contracts": ["./packages/contracts/src/index.ts"],
      "@zainx/contracts/*": ["./packages/contracts/src/*"],
      "@zainx/people": ["./packages/people/src/index.ts"],
      "@zainx/people/*": ["./packages/people/src/*"],
      "@zainx/attendance": ["./packages/attendance/src/index.ts"],
      "@zainx/attendance/*": ["./packages/attendance/src/*"],
      "@zainx/leave": ["./packages/leave/src/index.ts"],
      "@zainx/leave/*": ["./packages/leave/src/*"],
      "@zainx/payroll": ["./packages/payroll/src/index.ts"],
      "@zainx/payroll/*": ["./packages/payroll/src/*"],
      "@zainx/recruitment": ["./packages/recruitment/src/index.ts"],
      "@zainx/recruitment/*": ["./packages/recruitment/src/*"],
      "@zainx/approvals": ["./packages/approvals/src/index.ts"],
      "@zainx/approvals/*": ["./packages/approvals/src/*"],
      "@zainx/reports": ["./packages/reports/src/index.ts"],
      "@zainx/reports/*": ["./packages/reports/src/*"],
      "@zainx/administration": ["./packages/administration/src/index.ts"],
      "@zainx/administration/*": ["./packages/administration/src/*"],
      "@zainx/ai": ["./packages/ai/src/index.ts"],
      "@zainx/ai/*": ["./packages/ai/src/*"]
    }
  }
}
