{
  "name": "design-system-docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/design-system-docs/src",
  "projectType": "application",
  "tags": ["scope:docs", "type:app"],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/design-system-docs"
      }
    },
    "serve": {
      "executor": "@nx/vite:dev-server",
      "options": {
        "buildTarget": "design-system-docs:build"
      }
    },
    "build-storybook": {
      "executor": "@nx/storybook:build",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/design-system-docs",
        "configDir": "apps/design-system-docs/.storybook"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
